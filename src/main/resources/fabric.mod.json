			"com.duox.telex.VietnameseTelexClient"
		]
	},
	"mixins": [
		"vietnamesetelex.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
